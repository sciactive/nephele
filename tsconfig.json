{
  "extends": "@tsconfig/recommended/tsconfig.json",

  "compilerOptions": {
    "types": ["node", "jest"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2024"],
    "target": "es2024",
    "noImplicitAny": true,
    "removeComments": false,
    "sourceMap": true,
    "resolveJsonModule": true,
    "declaration": true
  },
  "exclude": ["node_modules", "**/*.spec.ts"]
}
